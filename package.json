{
  "name": "skybook",
  "version": "1.0.0",
  "description": "SkyBook — Tour Operations & Booking Admin",
  "author": "Aero Digital <info@aerodigital.space>",
  "main": "electron/main.js",
  "scripts": {
    "electron": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "test:smoke": "playwright test",
    "test:smoke:headed": "playwright test --headed",
    "test:smoke:list": "playwright test --list",
    "test:smoke:install-browsers": "playwright install chromium"
  },
  "build": {
    "appId": "space.aerodigital.skybook",
    "productName": "SkyBook",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/main.js"
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "artifactName": "SkyBook-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SkyBook"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "artifactName": "SkyBook.dmg"
    },
    "dmg": {
      "title": "Install SkyBook"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3",
    "supabase": "^2.92.0"
  }
}
